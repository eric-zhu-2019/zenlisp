{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZParen",
  "version": "0.1.2",
  "identifier": "dev.zparen.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "scripts/bundle-sbcl.sh && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZParen",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/swank/": "resources/swank/",
      "../resources/lisp/": "resources/lisp/",
      "sbcl/": "sbcl/"
    },
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
